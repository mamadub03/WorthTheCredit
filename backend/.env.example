# AI-GENERATED (Cursor Agent) — Issues #2–#3 / #8
# Copy this file to .env for local development. Never commit real secrets.
# .env is gitignored at the repository root.

# Application
APP_NAME=WorthTheCredit API
APP_ENV=development
DEBUG=true

# HTTP server (used by uvicorn when started via documented commands)
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the API (React Vite default below).
# Add production frontend origins later; do not use "*" with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tiger Data PostgreSQL (SQLAlchemy + Alembic). Required for DB work.
# Use the psycopg v3 driver prefix shown below.
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Auth0 — Backend JWT validation (Issue #8). Same tenant as Frontend 2 (#26).
# Example domain: your-tenant.us.auth0.com  (no https://)
# Audience: Auth0 API identifier, e.g. https://worththecredit.api
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
# Optional; defaults to https://{AUTH0_DOMAIN}/
# AUTH0_ISSUER=

# Placeholders for later issues
# GEMINI_API_KEY=
