# WorthTheCredit frontend settings. Copy to .env.local (ignored by git through *.local).
# Every value here ends up in the browser bundle, so nothing secret belongs in this file.
# Backend secrets (DATABASE_URL, GEMINI_API_KEY, Auth0 Client Secret) stay in backend/.env only.

# The FastAPI server. CORS already allows http://localhost:5173 / http://127.0.0.1:5173.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Which API areas the in-browser mock serves instead of the server:
# all, none, or a list of courses, reviews, recommendations.
# Backend is live on main for courses, reviews, and recommendations (Auth0 required for writes / AI).
# Use "none" once Auth0 login works; keep mocks only while developing UI without a token.
VITE_API_MOCKS=none

# npm run dev only: fake signed-in student while Auth0 is not configured.
# Ignored automatically once the three VITE_AUTH0_* values below are set.
VITE_DEV_AUTH=false
VITE_DEV_AUTH_UNVERIFIED=false

# Auth0 SPA (shared tenant with Backend 1). Client ID is public; never put Client Secret here.
VITE_AUTH0_DOMAIN=dev-gkpxcw3ptzv3y0hl.us.auth0.com
VITE_AUTH0_CLIENT_ID=5H6g2CfxIhE74h2luXjTlMuRb6cvRHHI
VITE_AUTH0_AUDIENCE=https://worththecredit.api
