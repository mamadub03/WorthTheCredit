# WorthTheCredit frontend settings. Copy to .env.local (ignored by git through *.local).
# Every value here ends up in the browser bundle, so nothing secret belongs in this file.

# The FastAPI server. Its CORS list already allows http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000

# Which API areas the in-browser mock serves instead of the server:
# all, none, or a list of courses, reviews, recommendations.
# Use none with the backend running (docs/local-integration.md), or all for a fully offline demo.
# Don't mock reviews against the real course list: the mock only knows its own course ids.
# A "Demo mode" banner shows whenever any area is mocked.
VITE_API_MOCKS=none

# npm run dev only: a fake signed-in student for offline work with VITE_API_MOCKS=all.
# The real backend accepts only Auth0 tokens, so dev sign-in can't post to it.
# Production builds ignore it, and real Auth0 sign-in takes over once the three Auth0 values are set.
VITE_DEV_AUTH=true
# Start the dev student with an unverified email, to try the verify-email screen.
VITE_DEV_AUTH_UNVERIFIED=false

# Auth0 single-page app and API audience, in .env.local only. The team's values are on issue #26.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
