# WorthTheCredit frontend settings. Copy to .env.local (ignored by git through *.local).
# Every value here ends up in the browser bundle, so nothing secret belongs in this file.

# The FastAPI server. Both backends' CORS lists already allow http://localhost:5173.
VITE_API_BASE_URL=http://localhost:8000

# Which API areas the in-browser mock serves instead of the server:
# all, none, or a list of courses, reviews, profile, recommendations, auth.
# A "Demo mode" banner shows whenever any area is mocked.
VITE_API_MOCKS=all

# npm run dev only: a fake signed-in student while there's no Auth0 tenant.
# It sends BE2's dev tokens, which BE2's API accepts when it runs with DEV_AUTH_BYPASS=true.
# Production builds ignore it, and real Auth0 sign-in takes over once the three Auth0 values are set.
VITE_DEV_AUTH=true
# Start the dev student with an unverified email, to try the verify-email screen.
VITE_DEV_AUTH_UNVERIFIED=false

# Auth0 single-page app and API audience. Leave empty until the tenant exists.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
